# Database Configuration
DATABASE_URL=postgresql://postgres:root@localhost:5432/stockpilot

# n8n Webhook URLs (get these from n8n Cloud after creating workflows)
N8N_PO_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/po-approval
N8N_ALERT_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/critical-alert
N8N_INVENTORY_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/inventory-update

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# LLM Configuration
# Ollama (Primary) - Remote teammate laptop
OLLAMA_BASE_URL=http://192.168.137.238:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=-1

# Gemini (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider (ollama or gemini)
LLM_PROVIDER=ollama

# StockPilot API Configuration (for n8n callbacks)
STOCKPILOT_API_URL=http://localhost:8000
# For demo, use ngrok or similar: https://your-ngrok-url.ngrok.io

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security
API_KEY=your_api_key_here  # Optional: for securing endpoints

# Service Level Target
SERVICE_LEVEL=0.95  # 95% service level

# Forecast Settings
FORECAST_HORIZON_DAYS=30
MOVING_AVERAGE_WINDOW=14
